<Project Sdk="Microsoft.NET.Sdk">

  <!-- Lançador do S6: cria um processo-filho restrito por um Job Object do Windows e verifica a contenção.
       Específico do Windows; no produto fica atrás de ISandboxLauncher (ADR-0018). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);SYSLIB1054</NoWarn>
  </PropertyGroup>

</Project>
