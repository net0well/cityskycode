<Project Sdk="Microsoft.NET.Sdk">

  <!-- Geração da malha de ruas e interseções. A matemática é independente da engine (System.Numerics);
       na Fase 3 o mesmo algoritmo vira o gerador de malha da Presentation (Unity Mesh). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
