<Project>

  <!-- Herda a props comum e relaxa o que não cabe em projeto de teste. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Nomes de teste Metodo_Cenario_Esperado usam sublinhado (CA1707); fixtures NUnit descartam
         campos no OneTimeTearDown, não via IDisposable (CA1001). -->
    <NoWarn>$(NoWarn);CA1707;CA1001</NoWarn>
  </PropertyGroup>

</Project>
