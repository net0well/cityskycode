<Project Sdk="Microsoft.NET.Sdk">

  <!-- Servidor IPC, workspace Roslyn, pipeline e gerência de workers. Executável. C# 14.
       Referencia o Worker para o exe ir para a mesma pasta (o ISandboxLauncher o inicia). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CitySky.CodeHost</RootNamespace>
    <AssemblyName>CitySky.CodeHost</AssemblyName>
    <!-- Logging de alta performance (LoggerMessage source-gen) é um follow-up; v0 loga pouco. -->
    <NoWarn>$(NoWarn);CA1848;CA1873</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Newtonsoft.Json" />
    <ProjectReference Include="..\CitySky.Contracts\CitySky.Contracts.csproj" />
    <ProjectReference Include="..\CitySky.CodeAnalysis\CitySky.CodeAnalysis.csproj" />
    <ProjectReference Include="..\CitySky.PlayerApi\CitySky.PlayerApi.csproj" />
    <ProjectReference Include="..\CitySky.Sandbox.Worker\CitySky.Sandbox.Worker.csproj" />
  </ItemGroup>

</Project>
